# ACRCloud identification (leave key/secret blank to disable)
ACR_HOST=identify-us-west-2.acrcloud.com
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
ACR_PROJECT_ID=
IDENTIFY_CONCURRENCY=2

# Server
PORT=9000
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_DURATION_SECS=1200
CORS_ORIGINS=*

# Live microphone streaming
LIVE_CLIP_SECS=30
LIVE_MAX_MINUTES=60

# Host port docker compose publishes the API on
HOST_PORT=9000
# Music matches below this score (0-100) are reported as possible_match
ACR_MIN_SCORE=50
